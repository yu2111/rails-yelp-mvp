<div class="container mt-3">
  <p class="m-3"><%= link_to '<< Back to Restaurants', restaurants_path, class: 'text-decoration-none' %></p>
  <div class="card-trip">
    <img src="https://loremflickr.com/320/200/restaurant,<%= @restaurant.category&.downcase %>/all?lock=<%= @restaurant.id %>" />
    <div class="card-trip-infos">
      <div>
        <h1><%= @restaurant.name %></h1>
        <p><%= @restaurant.category %></p>
        <p><%= @restaurant.address %></p>
        <p><%= @restaurant.phone_number %></p>
      </div>
      <h2 class="card-trip-pricing">
        <% if @rating %>
          <% @rating.times do %>
            <i class="fa-solid fa-star"></i>
          <% end %>
        <% else %>
        <%= "no ratings yet" %>
        <% end %>
      </h2>
    </div>
  </div>
  <%= link_to 'Add a review', new_restaurant_review_path(@restaurant), class: 'btn btn-primary m-3' %>
  <div>
    <h3>Reviews</h3>
    <% if @reviews.any? %>
      <% @reviews.each do |review| %>
        <p><%= review.content %></p>
      <% end %>
    <% else %>
      <p><%= "No reviews yet" %></p>
    <% end %>
  </div>
</div>
